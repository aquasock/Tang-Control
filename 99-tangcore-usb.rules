# Allow the locally logged-in user to access TangCore's CDC console and keep
# ModemManager from probing it as though it were a modem.
SUBSYSTEM=="tty", ATTRS{idVendor}=="ffff", ATTRS{idProduct}=="6160", GROUP="plugdev", MODE="0660", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"

# Bouffalo BL616 ROM programming mode used for application-only firmware
# updates after holding BOOT and tapping RESET.
SUBSYSTEM=="tty", ATTRS{idVendor}=="349b", ATTRS{idProduct}=="6160", GROUP="plugdev", MODE="0660", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
